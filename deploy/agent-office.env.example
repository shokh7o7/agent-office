# Copy to /etc/agent-office.env on the server, then: sudo chmod 600 /etc/agent-office.env
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-flash-latest
# Model for "Strong mode" tasks (deeper work; needs billing for real use)
GEMINI_STRONG_MODEL=gemini-pro-latest
# high | low | off | <token budget>. Falls back automatically if a model rejects it.
GEMINI_THINKING=high
# Model turns allowed per PC task (each turn = 1 Gemini request)
MAX_TOOL_STEPS=60
MAX_CONCURRENCY=2
# Shared secret your PC runners must present. Make one with: openssl rand -hex 24
RUNNER_TOKEN=
